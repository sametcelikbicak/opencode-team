{
  "name": "@opencodeteam/cli",
  "version": "0.0.4",
  "description": "A team of AI agents that takes an idea from research to launch — built on opencode, with no framework and no extra dependencies.",
  "type": "module",
  "bin": {
    "opencode-team": "bin/opencode-team"
  },
  "files": [
    "bin/",
    "assets/",
    "agents/",
    "commands/",
    "skills/",
    "team.yaml",
    "team/AGENTS.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "author": "Samet ÇELİKBIÇAK",
  "license": "MIT",
  "keywords": [
    "opencode",
    "ai-agents",
    "pipeline",
    "cli",
    "software-team",
    "research",
    "prd",
    "backlog",
    "ux",
    "brand",
    "architecture",
    "build",
    "qa",
    "security",
    "docs",
    "release",
    "launch"
  ],
  "preferGlobal": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sametcelikbicak/opencode-team.git"
  },
  "bugs": {
    "url": "https://github.com/sametcelikbicak/opencode-team/issues"
  },
  "homepage": "https://sametcelikbicak.github.io/opencode-team/",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "allowScripts": {},
  "scripts": {
    "generate:reference": "ruby scripts/generate-reference.rb",
    "docs:dev": "npm run generate:reference && vitepress dev docs",
    "docs:build": "npm run generate:reference && vitepress build docs",
    "docs:preview": "npm run generate:reference && vitepress preview docs",
    "test": "node --test bin/*.test.js"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=22"
  }
}
